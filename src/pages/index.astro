---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import {brand,domain,cities} from '../data/cities';
const title='Fix and Flip Loans in Greater Birmingham, AL | Birmingham Metro Fix & Flip Loan';
const description='We connect Birmingham, Hoover, Homewood and Bessemer area investors with fix and flip funding sources. Funding within 48 hours. Tell us your goal.';
const businessId=`https://${domain}/#business`;
const faq=[{q:'Are you a direct lender?',a:'No. We are connectors. We introduce investors to funding sources, and the funding source determines eligibility and terms.'},{q:'Does submitting guarantee funding?',a:'No. A submission starts a review, not an approval or commitment.'}];
const areas=cities.map(c=>({'@type':'City',name:c.name,containedInPlace:{'@type':'State',name:'Alabama'}}));
const jsonld=[{'@context':'https://schema.org','@type':'WebSite',name:brand,url:`https://${domain}/`},{'@context':'https://schema.org','@type':'FinancialService','@id':businessId,name:brand,url:`https://${domain}/`,areaServed:areas,description:'Fix and flip funding connections for real estate investors across Birmingham, Hoover, Homewood, Bessemer and the surrounding Jefferson and Shelby county area. Not a direct lender.'},{'@context':'https://schema.org','@type':'Service',serviceType:'Fix and flip funding connection service',provider:{'@id':businessId},areaServed:areas},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<Base title={title} description={description} path="/" jsonld={jsonld}><Header/><main><CityContent cityName="Birmingham Metro" location="Homepage" intro="Greater Birmingham grew up around iron and steel, and the housing shows it: mill-era bungalows, hillside Tudors on Red Mountain, and newer subdivisions across Shelby County. Tell us about the home, the work you plan and how you expect to sell. We are connectors, and we introduce your project to funding sources for funding within 48 hours." angle="An Ensley bungalow, a Homewood Tudor and an Alabaster subdivision home call for different repair scopes and sell to different buyers. Start with the real condition of the house, the work you plan and recent sales from the same neighborhood, not the metro as a whole." caution="Hills, old mining ground and limestone terrain all matter here. Check foundations, drainage and slope early, and tell us what you have already confirmed." showCityGrid={true}/></main><Footer/></Base>
